{
  "name": "@pct/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Runs agents on the PC of whoever started them: our own loop for model APIs, and headless CLI agents, all checked against locks, task scope and approvals.",
  "type": "module",
  "exports": {
    ".": {
      "@pct/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@pct/shared": "0.1.0",
    "zod": "^4.1.12"
  }
}
